{
  "name": "trainguard",
  "version": "2.0.0",
  "description": "Never board the wrong train: an offline Indian Railways pass, look-alike train warnings and wake-up alerts.",
  "main": "src/parser.js",
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node tests/parser.test.js && node tests/timetable.test.js && node tests/app.test.js",
    "test:browser": "python tests/browser/run.py",
    "test:watch": "node scripts/build.js && python tests/browser/watch.py"
  },
  "keywords": [
    "irctc",
    "indian-railways",
    "train-guard",
    "pwa",
    "boarding-pass"
  ],
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.0"
  }
}
